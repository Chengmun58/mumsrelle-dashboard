NODE_ENV=development
PORT=3000

# Authentication and database
DATABASE_URL=mysql://user:password@host:3306/mumsrelle_dashboard
JWT_SECRET=replace-with-a-long-random-secret
OWNER_OPEN_ID=replace-with-the-owner-open-id
OAUTH_SERVER_URL=https://replace-with-oauth-server
VITE_OAUTH_PORTAL_URL=https://replace-with-oauth-portal
VITE_APP_ID=replace-with-app-id

# CSO Casesheet. The sheet must be accessible to the deployed server.
CSO_SHEET_ID=replace-with-sheet-id
CSO_KIV_GID=replace-with-kiv-tab-gid
CSO_SIGNED_GID=replace-with-signed-up-tab-gid
CSO_DAILY_GID=replace-with-cso-daily-update-tab-gid

# Live sales overview JSON endpoint. If omitted, the bundled 2025 snapshot is
# shown with a warning. SALES_OVERVIEW_TOKEN is optional.
SALES_OVERVIEW_URL=https://replace-with-live-overview-endpoint
SALES_OVERVIEW_TOKEN=

# Optional Manus runtime services
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
